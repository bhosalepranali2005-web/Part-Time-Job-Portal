<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-100 min-h-screen grid place-items-center"><form action="/admin/login" method="post" class="bg-white p-8 rounded-xl shadow w-full max-w-sm grid gap-4"><h1 class="text-2xl font-bold">Admin login</h1><% if(error){ %><p class="text-red-600"><%= error %></p><% } %><input class="border p-3 rounded" type="email" name="email" placeholder="Email" required><input class="border p-3 rounded" type="password" name="password" placeholder="Password" required><button class="bg-indigo-700 text-white p-3 rounded">Sign in</button></form></body></html>
