<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><script src="https://cdn.tailwindcss.com"></script><title><%= job.title %></title></head><body class="bg-slate-50"><main class="max-w-3xl mx-auto p-6"><a href="/" class="text-indigo-700">← All jobs</a><article id="details" class="bg-white shadow rounded-xl p-8 mt-5"><h1 class="text-3xl font-bold"><%= job.title %></h1><p class="text-slate-600 mt-2"><%= job.company %> · <%= job.location %> · <%= job.salary %></p><p class="whitespace-pre-wrap mt-6"><%= job.description %></p></article><section class="bg-white shadow rounded-xl p-8 mt-6"><h2 class="text-2xl font-bold mb-4">Apply now</h2><form id="apply" class="grid gap-4"><input name="fullName" required maxlength="120" placeholder="Full name" class="border p-3 rounded"><input name="email" type="email" required placeholder="Email" class="border p-3 rounded"><input name="phone" required maxlength="30" placeholder="Phone" class="border p-3 rounded"><input name="resume" type="file" accept="application/pdf,.pdf" required class="border p-3 rounded"><textarea name="coverLetter" maxlength="5000" placeholder="Cover letter (optional)" class="border p-3 rounded"></textarea><button class="bg-indigo-700 text-white p-3 rounded">Submit application</button></form><p id="message" role="status" class="mt-4"></p></section></main><script src="/socket.io/socket.io.js"></script><script src="/js/job.js"></script></body></html>
