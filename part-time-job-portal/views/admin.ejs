<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><script src="https://cdn.tailwindcss.com"></script><title>Admin dashboard</title></head><body class="bg-slate-50"><header class="bg-slate-900 text-white p-5 flex justify-between"><h1 class="text-2xl font-bold">ShiftFind Admin</h1><form method="post" action="/admin/logout"><button class="underline">Log out</button></form></header><main class="max-w-6xl mx-auto p-6"><section class="bg-white rounded-xl shadow p-6 mb-8"><h2 id="formTitle" class="text-xl font-bold mb-4">Add job</h2><form id="jobForm" class="grid md:grid-cols-2 gap-3"><input name="title" required placeholder="Job title" class="border p-3 rounded"><input name="company" required placeholder="Company" class="border p-3 rounded"><input name="location" required placeholder="Location" class="border p-3 rounded"><input name="salary" required placeholder="Salary" class="border p-3 rounded"><input name="category" required placeholder="Category" class="border p-3 rounded"><textarea name="description" required placeholder="Description" class="border p-3 rounded md:col-span-2"></textarea><button class="bg-indigo-700 text-white rounded p-3">Save job</button><button type="button" id="cancel" class="border rounded p-3">Cancel edit</button></form><p id="notice" role="status"></p></section><h2 class="text-2xl font-bold mb-4">All jobs</h2><div id="adminJobs" class="grid gap-4"></div><section class="bg-white shadow rounded-xl p-6 mt-8"><h2 id="applicationTitle" class="text-xl font-bold mb-4">Applications</h2><div id="applications" class="grid gap-3">Select a job to view applications.</div></section></main><script src="/socket.io/socket.io.js"></script><script src="/js/admin.js"></script></body></html>
